-- 🔗 Chunk-to-Chunk Links
DEFINE TABLE chunk_link RELATES chunk -> chunk;

-- 🔗 Note-to-Note (optional, derived from chunk_link)
DEFINE TABLE note_link RELATES note -> note;

-- 🔗 Note ↔ Tag edges
DEFINE TABLE note_tag RELATES note -> tag;

-- 🔗 Chunk ↔ Tag edges
DEFINE TABLE chunk_tag RELATES chunk -> tag;